# development | staging | production
APP_ENV=development

# Uvicorn local server settings
HOST=127.0.0.1
PORT=8000

# PostgreSQL is required for staging/production.
# Local development database verified for this project:
#   createdb residuos_clara_dev
#   DATABASE_URL=postgresql+psycopg2://<usuario>@localhost:5432/residuos_clara_dev
# Leaving it empty falls back to SQLite, allowed only in development.
DATABASE_URL=

# Optional: run the test suite against PostgreSQL instead of SQLite.
# The database is wiped on every test (alembic downgrade base + upgrade head),
# so it must be a throwaway database.
#   createdb residuos_clara_test
# CLARA_TEST_DATABASE_URL=postgresql+psycopg2://<usuario>@localhost:5432/residuos_clara_test

# Optional path to the historical Excel used by /api/v1/historico/benchmark
HISTORICAL_EXCEL_PATH=

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
