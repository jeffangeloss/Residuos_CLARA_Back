# development | staging | production
APP_ENV=development

# Uvicorn local server settings
HOST=127.0.0.1
PORT=8000

# PostgreSQL is the only supported engine, in every environment.
# The service refuses to start without this value: there is no on-disk fallback.
#   createdb residuos_clara_dev
DATABASE_URL=postgresql+psycopg2://<usuario>@localhost:5432/residuos_clara_dev

# Throwaway database for the test suite. It is wiped on every test
# (alembic downgrade base + upgrade head), so it must not hold real data.
# Defaults to residuos_clara_test on localhost with the current system user.
#   createdb residuos_clara_test
# CLARA_TEST_DATABASE_URL=postgresql+psycopg2://<usuario>@localhost:5432/residuos_clara_test

# Where container photographs are stored. Defaults to almacenamiento/fotos
# ALMACENAMIENTO_FOTOS=almacenamiento/fotos

# Optional path to the historical Excel used by /api/v1/historico/benchmark
HISTORICAL_EXCEL_PATH=

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
